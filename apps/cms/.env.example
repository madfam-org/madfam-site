# CMS configuration — placeholder-only.
# Do not paste live values into this file. Production and staging values come
# from the cluster secret (Enclii secrets backed by Lockbox/Vault/ESO).

NODE_ENV=development
# The container listens on 3000; the k8s Service maps 80 -> 3000.
PORT=3000

# Payload
PAYLOAD_SECRET=replace-with-payload-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres. Wave 0 still shares the site database; a dedicated CNPG database is
# Wave 2.
DATABASE_URL=replace-with-local-or-secret-store-database-url

# Comma-separated CORS/CSRF allow-list. Defaults to
# http://localhost:3000,https://madfam.io,https://staging.madfam.io
CMS_ALLOWED_ORIGINS=http://localhost:3000,https://madfam.io,https://staging.madfam.io

# Cache-invalidation webhook on the consuming site
# (POST {collection, operation, id} with an x-webhook-secret header).
CMS_REBUILD_WEBHOOK_URL=replace-with-consumer-webhook-url
CMS_WEBHOOK_SECRET=replace-with-webhook-secret

# Media storage (S3-compatible, Cloudflare R2). All four are required before the
# storage adapter turns on; without them uploads fall back to local disk, which
# cannot work under readOnlyRootFilesystem.
R2_BUCKET=replace-with-bucket-name
R2_ENDPOINT=replace-with-r2-s3-endpoint
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
